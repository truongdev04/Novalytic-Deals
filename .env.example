# Postgres (Supabase). DIRECT_URL is used by Prisma Migrate; DATABASE_URL can point
# to a pooled connection (pgbouncer, port 6543) in production.
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Upstash Redis (cache + rate limit) - REST API credentials, not a single REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Storage (admin logo/banner uploads, alternate provider). Project
# settings > API for the URL, and the service_role secret key (never expose
# this client-side). Also create a public bucket named "store-assets" in the
# Supabase dashboard.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (admin logo/banner uploads, default provider). From the
# Cloudinary dashboard's "API Environment variable" section.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NextAuth (admin auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# Auth.js v5 reads AUTH_URL/AUTH_TRUST_HOST (not NEXTAUTH_URL) to decide
# trustHost outside of Vercel/Cloudflare Pages/dev — set this to the same
# value as NEXTAUTH_URL (or the real domain in production) to avoid
# UntrustedHost errors on `next start`/self-hosting. Not required on Vercel,
# which sets its own VERCEL env var that Auth.js trusts automatically.
AUTH_URL="http://localhost:3000"

# Resend (email)
RESEND_API_KEY=
# Recipient for contact-form submissions.
CONTACT_INBOX_EMAIL=
# Sender ("from") for system emails (newsletter confirmation, etc). Must be
# on a domain verified in Resend, or sending will fail.
EMAIL_FROM=

# Cloudflare Turnstile (anti-spam). NEXT_PUBLIC_ variant is the client widget
# site key; TURNSTILE_SECRET_KEY stays server-only. Verification is skipped
# when TURNSTILE_SECRET_KEY is unset, so forms still work before this is set up.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Affiliate defaults
AFFILIATE_DEFAULT_NETWORK=""

# Public site config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# First admin user, created by prisma/seed.ts
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Vercel Cron (app/api/cron/daily-refresh) — protects the endpoint. Vercel
# auto-sends `Authorization: Bearer <CRON_SECRET>` when this is set as a
# project env var; generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=""
